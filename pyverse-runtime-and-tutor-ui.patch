+++ b/pyverse/static/css/pyverse-blog.css
@@ -0,0 +1,100 @@
+/* Notes / blog, in the site's own look: cream surface, ink borders, hard
+ * shadows, mono labels. Replaces Puput's Bootstrap theme (white page, blue
+ * bars). Scoped under `.pv-blog`; colours are the site palette literals so the
+ * blog does not depend on Tailwind's load order. */
+
+.pv-blog { --ink: #1a1a1a; --bg2: #ede6d2; --device: #d6cebd; --red: #c62828; --muted: #6b6355; --body: #3a3529; }
+.pv-blog a { color: var(--ink); }
+
+/* cards: entry summaries and the entry itself */
+.pv-blog .pv-card {
+  background: var(--bg2); border: 3px solid var(--ink); box-shadow: 3px 3px 0 0 var(--ink);
+  padding: 22px 24px; margin-bottom: 22px;
+}
+.pv-blog .pv-title { margin: 0 0 8px; font-weight: 900; font-size: clamp(22px, 3vw, 30px); line-height: 1.1; letter-spacing: -0.02em; }
+.pv-blog .pv-title a { text-decoration: none; }
+.pv-blog .pv-title a:hover { color: var(--red); }
+
+/* meta line under a title */
+.pv-blog .pv-meta { list-style: none; margin: 0 0 14px; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 14px;
+  font-family: "JetBrains Mono", monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
+.pv-blog .pv-meta a { color: var(--muted); text-decoration: none; }
+.pv-blog .pv-meta a:hover { color: var(--red); }
+.pv-blog .pv-meta ul { display: inline; list-style: none; margin: 0; padding: 0; }
+.pv-blog .pv-meta li { display: inline; }
+.pv-blog .pv-meta ul li + li::before { content: ", "; }
+
+/* bodies */
+.pv-blog .pv-excerpt, .pv-blog .pv-body { color: var(--body); line-height: 1.7; }
+.pv-blog .pv-excerpt p, .pv-blog .pv-body p { margin: 0 0 .8em; }
+.pv-blog .pv-body h2, .pv-blog .pv-body h3 { font-weight: 900; letter-spacing: -0.01em; margin: 1.4em 0 .5em; }
+.pv-blog .pv-body ul, .pv-blog .pv-body ol { padding-left: 1.3em; margin: 0 0 1em; }
+.pv-blog .pv-body ul { list-style: disc; } .pv-blog .pv-body ol { list-style: decimal; }
+.pv-blog .pv-body ul li { font-family: inherit; font-size: inherit; padding: 2px 0; border: 0; }
+.pv-blog .pv-body ul li::before { content: none; }
+.pv-blog .pv-body a { color: var(--red); text-decoration: underline; text-underline-offset: 3px; }
+.pv-blog .pv-body code, .pv-blog .pv-excerpt code { font-family: "JetBrains Mono", monospace; font-size: .88em; background: var(--device); padding: 1px 5px; }
+.pv-blog .pv-body pre { background: #1a1a1a; color: #f5eeda; padding: 14px 16px; overflow-x: auto; margin: 0 0 1em; font-size: 13px; line-height: 1.6; }
+.pv-blog .pv-body pre code { background: none; padding: 0; color: inherit; }
+.pv-blog .pv-body img, .pv-blog .pv-hero img, .pv-blog .pv-card img { max-width: 100%; height: auto; border: 3px solid var(--ink); }
+.pv-blog .pv-hero { display: block; margin: 0 0 16px; }
+
+/* footer row: share links + button */
+.pv-blog .pv-card-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
+  margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(26,26,26,.18); }
+.pv-blog .pv-share { list-style: none; margin: 0; padding: 0; display: flex; gap: 12px;
+  font-family: "JetBrains Mono", monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; }
+.pv-blog .pv-share a { color: var(--muted); text-decoration: none; }
+.pv-blog .pv-share a:hover { color: var(--red); }
+.pv-blog .pv-btn, .pv-blog .pv-search button {
+  display: inline-block; font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 12px;
+  padding: 7px 14px; border: 3px solid var(--ink); background: var(--ink); color: #f5eeda !important; text-decoration: none; cursor: pointer;
+}
+.pv-blog .pv-btn:hover, .pv-blog .pv-search button:hover { background: var(--red); border-color: var(--ink); }
+
+/* sidebar */
+.pv-blog .pv-side { background: var(--bg2); border: 3px solid var(--ink); box-shadow: 3px 3px 0 0 var(--ink); padding: 16px 18px; }
+.pv-blog .pv-side h4 { margin: 0 0 10px; font-family: "JetBrains Mono", monospace; font-size: 11px; font-weight: 700;
+  text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
+.pv-blog .pv-side ul { list-style: none; margin: 0; padding: 0; }
+.pv-blog .pv-side li { padding: 5px 0; font-size: 13.5px; border-bottom: 1px solid rgba(26,26,26,.1); }
+.pv-blog .pv-side li:last-child { border-bottom: 0; }
+.pv-blog .pv-side a { text-decoration: none; font-weight: 600; }
+.pv-blog .pv-side a:hover { color: var(--red); }
+.pv-blog .pv-sub { display: block; font-family: "JetBrains Mono", monospace; font-size: 10.5px; color: var(--muted); margin-top: 2px; }
+.pv-blog .pv-side li.tag { display: inline-block; border: 0; padding: 0; margin: 0 6px 6px 0; }
+.pv-blog .pv-side li.tag a { display: inline-block; border: 2px solid var(--ink); padding: 1px 8px; font-family: "JetBrains Mono", monospace; font-size: 11px; background: #f5eeda; }
+.pv-blog .pv-archive ul.sub { margin: 2px 0 6px 14px; }
+.pv-blog .pv-archive .open-sub { display: none; }
+
+.pv-blog .pv-feed { font-family: "JetBrains Mono", monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); text-decoration: none; }
+.pv-blog .pv-feed:hover { color: var(--red); }
+.pv-blog .pv-search { display: flex; }
+.pv-blog .pv-search input { flex: 1; min-width: 0; border: 3px solid var(--ink); border-right: 0; background: #f5eeda; padding: 7px 10px;
+  font-family: "JetBrains Mono", monospace; font-size: 12px; color: var(--ink); outline: none; border-radius: 0; }
+.pv-blog .pv-search input:focus { background: #fff9e8; }
+
+/* related */
+.pv-blog .pv-related { margin-top: 36px; }
+.pv-blog .pv-related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; }
+.pv-blog .pv-related .pv-card { margin: 0; padding: 16px; }
+.pv-blog .pv-related h3 { font-size: 15px; font-weight: 800; margin: 8px 0 4px; }
+.pv-blog .pv-related h3 a { text-decoration: none; }
+.pv-blog .pv-related p { font-size: 13px; color: var(--body); margin: 0; }
+
+/* django-el-pagination output */
+.pv-blog .pv-pagination { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; font-family: "JetBrains Mono", monospace; font-size: 12px; }
+.pv-blog .pv-pagination a, .pv-blog .pv-pagination .endless_page_current, .pv-blog .pv-pagination .endless_separator {
+  border: 2px solid var(--ink); padding: 3px 10px; text-decoration: none; background: transparent; }
+.pv-blog .pv-pagination a:hover { background: var(--ink); color: #f5eeda; }
+.pv-blog .pv-pagination .endless_page_current { background: var(--ink); color: #f5eeda; }
+.pv-blog .pv-pagination .endless_separator { border-color: transparent; }
+
+/* Rich-text rules (underlined red links, "+ " list markers) must not leak into
+ * the button and share row that live inside the entry body. */
+.pv-blog .pv-body .pv-btn { color: #f5eeda !important; text-decoration: none; }
+.pv-blog .pv-body .pv-share { list-style: none; padding: 0; margin: 0; }
+.pv-blog .pv-body .pv-share li { padding: 0; border: 0; font-family: inherit; font-size: inherit; }
+.pv-blog .pv-body .pv-share li::before { content: none; }
+.pv-blog .pv-body .pv-share a { color: var(--muted); text-decoration: none; }
+.pv-blog .pv-body .pv-share a:hover { color: var(--red); }
diff --git a/pyverse/static/css/tutor-view.css b/pyverse/static/css/tutor-view.css
new file mode 100644
index 0000000..5ec314f
--- /dev/null
+++ b/pyverse/static/css/tutor-view.css
@@ -0,0 +1,87 @@
+/* Python Tutor-style step-through, in the site palette (cream, ink, hard shadow).
+ * Scoped under `.tv`; literals rather than Tailwind so load order cannot matter. */
+.tv { --ink:#1a1a1a; --cream:#f5eeda; --bg2:#ede6d2; --device:#d6cebd; --screen:#c8d5b9; --screen-dk:#3d4f2f;
+  --red:#c62828; --muted:#6b6355; --code:#f9f4e3;
+  border: 3px solid var(--ink); box-shadow: 4px 4px 0 0 var(--ink); background: var(--cream); color: var(--ink);
+  font-family: "Inter", system-ui, sans-serif; }
+.tv * { box-sizing: border-box; }
+.tv-bar { display:flex; justify-content:space-between; gap:12px; align-items:center; padding:8px 14px;
+  background: var(--ink); color: var(--cream); font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing:.05em; text-transform: uppercase; }
+.tv-pill { text-transform:none; letter-spacing:0; max-width:60%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#c8d5b9; }
+.tv-pill-err { color:#ff9c9c; } .tv-pill-busy { color:#f0c47a; }
+
+.tv-grid { display:grid; grid-template-columns: minmax(300px, 46%) minmax(0, 1fr); gap: 0; }
+@media (max-width: 960px) { .tv-grid { grid-template-columns: 1fr; } .tv-left { border-right: 0 !important; border-bottom: 3px solid var(--ink); } }
+.tv-left { border-right: 3px solid var(--ink); min-width: 0; display:flex; flex-direction:column; }
+.tv-right { min-width: 0; display:flex; flex-direction:column; }
+
+/* code */
+.tv-code { background: var(--code); font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 13px; line-height: 1.55;
+  max-height: 440px; min-height: 200px; overflow: auto; padding: 8px 0; position: relative; }
+.tv-line { display:flex; align-items: stretch; white-space: pre; padding-right: 12px; }
+.tv-arrow { width: 22px; flex: none; text-align: center; font-size: 15px; line-height: 1.5; }
+.tv-no { width: 30px; flex: none; text-align: right; padding-right: 10px; color: var(--muted); opacity:.7; user-select:none; }
+.tv-src { font: inherit; background: none; padding: 0; color: var(--ink); }
+.tv-line.tv-next { background: rgba(198,40,40,.14); } .tv-line.tv-next .tv-arrow { color: var(--red); }
+.tv-line.tv-exec { background: rgba(61,79,47,.16); }  .tv-line.tv-exec .tv-arrow { color: var(--screen-dk); }
+.tv-harness .tv-src { opacity:.55; font-style: italic; }
+.tv-k { color:#8a2d22; font-weight:700; } .tv-s { color:#3d6b2a; } .tv-c { color:#8c8470; font-style:italic; }
+.tv-n { color:#9a5b00; } .tv-f { color:#1d4f8a; font-weight:700; } .tv-b { color:#1d4f8a; }
+
+.tv-legend { display:flex; gap:18px; padding:6px 12px; border-top: 2px solid var(--ink); background: var(--bg2);
+  font-family:"JetBrains Mono",monospace; font-size:10.5px; color: var(--muted); }
+.tv-key-exec { font-style:normal; color: var(--screen-dk); } .tv-key-next { font-style:normal; color: var(--red); }
+
+/* navigation */
+.tv-nav { padding: 10px 12px 12px; border-top: 2px solid var(--ink); background: var(--cream); }
+.tv-status { display:flex; flex-wrap:wrap; gap: 4px 14px; align-items: baseline; font-family:"JetBrains Mono",monospace; font-size:12px; }
+.tv-note { color: var(--screen-dk); font-weight:700; } .tv-note-bad { color: var(--red); }
+.tv-nav input[type=range] { width:100%; margin: 10px 0 8px; accent-color: var(--ink); }
+.tv-buttons { display:flex; flex-wrap:wrap; gap:8px; }
+.tv-buttons button { font-family:"JetBrains Mono",monospace; font-size:12px; font-weight:700; padding:5px 12px;
+  border:2px solid var(--ink); background: var(--cream); color: var(--ink); cursor:pointer; }
+.tv-buttons button:hover:not(:disabled) { background: var(--ink); color: var(--cream); }
+.tv-buttons button:disabled { opacity:.35; cursor: not-allowed; }
+.tv-buttons button:focus-visible, .tv-nav input:focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }
+
+/* right side */
+.tv-title { font-family:"JetBrains Mono",monospace; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color: var(--muted); margin-bottom:6px; }
+.tv-printbox { padding: 10px 12px; border-bottom: 3px solid var(--ink); background: var(--bg2); }
+.tv-print { max-height: 120px; min-height: 44px; overflow:auto; background: var(--code); border: 2px solid var(--ink); padding: 6px 8px; }
+.tv-print pre { margin:0; font-family:"JetBrains Mono",monospace; font-size:12.5px; white-space:pre-wrap; color: var(--ink); }
+.tv-err { margin-top:6px; font-family:"JetBrains Mono",monospace; font-size:12px; color: var(--red); font-weight:700; white-space:pre-wrap; }
+.tv-hide { display:none; }
+
+.tv-viz { flex:1; min-height: 260px; max-height: 520px; overflow:auto; padding: 12px; background: var(--cream); }
+.tv-vizin { position:relative; display:grid; grid-template-columns: minmax(150px, 1fr) minmax(190px, 1.2fr); gap: 34px; align-items:start; min-width: 380px; }
+.tv-arrows { position:absolute; left:0; top:0; pointer-events:none; overflow:visible; z-index:2; }
+.tv-col { position:relative; z-index:1; min-width:0; }
+
+.tv-frame { background: var(--bg2); border: 2px solid var(--ink); margin-bottom: 10px; }
+.tv-frame-cur { background: var(--screen); box-shadow: 3px 3px 0 0 var(--ink); }
+.tv-label { font-family:"JetBrains Mono",monospace; font-size:11px; font-weight:700; padding:3px 8px; border-bottom: 2px solid var(--ink); background: var(--device); }
+.tv-frame-cur .tv-label { background: var(--screen-dk); color: var(--cream); }
+.tv-frame table { width:100%; border-collapse: collapse; font-family:"JetBrains Mono",monospace; font-size:12.5px; }
+.tv-frame td { padding: 3px 8px; vertical-align: middle; border-bottom: 1px solid rgba(26,26,26,.12); }
+.tv-frame tr:last-child td { border-bottom: 0; }
+.tv-name { color: var(--muted); text-align: right; width: 42%; white-space: nowrap; }
+.tv-ret .tv-name, .tv-ret .tv-val { font-weight:700; color: var(--red); }
+.tv-hidden { text-align:center; font-family:"JetBrains Mono",monospace; font-size:11px; color: var(--muted); margin: -4px 0 10px; }
+
+.tv-obj { background: var(--bg2); border: 2px solid var(--ink); margin-bottom: 12px; width: fit-content; max-width: 100%; }
+.tv-cells { display:flex; flex-wrap:wrap; gap: 0; padding: 4px; }
+.tv-cell { border: 1.5px solid var(--ink); margin: 2px; min-width: 34px; background: var(--code); text-align:center; }
+.tv-idx { font-family:"JetBrains Mono",monospace; font-size:10px; color: var(--muted); border-bottom: 1px solid rgba(26,26,26,.25); padding: 0 4px; }
+.tv-cell .tv-val { padding: 4px 8px; font-family:"JetBrains Mono",monospace; font-size:12.5px; }
+.tv-kv { border-collapse: collapse; font-family:"JetBrains Mono",monospace; font-size:12.5px; }
+.tv-kv td { padding: 3px 8px; border-bottom: 1px solid rgba(26,26,26,.15); }
+.tv-kv .tv-key { background: var(--device); border-right: 1.5px solid var(--ink); text-align:right; }
+.tv-kv tr:last-child td { border-bottom: 0; }
+.tv-empty, .tv-none-yet { font-family:"JetBrains Mono",monospace; font-size:11px; color: var(--muted); padding: 4px 8px; }
+
+.tv-v { font-family:"JetBrains Mono",monospace; }
+.tv-num { color:#9a5b00; } .tv-str { color:#3d6b2a; } .tv-bool, .tv-none { color:#8a2d22; font-weight:700; } .tv-dim { color: var(--muted); }
+.tv-ptr { display:inline-block; width:9px; height:9px; border-radius:50%; background: var(--ink); vertical-align: middle; }
+.tv-func { color:#1d4f8a; }
+.tv-func { white-space: nowrap; display:inline-block; max-width: 190px; overflow:hidden; text-overflow: ellipsis; vertical-align: bottom; }
+.tv-name { width: 1%; }
