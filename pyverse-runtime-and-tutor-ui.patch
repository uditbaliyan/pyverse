diff --git a/pyverse/static/js/pyverse-runner.js b/pyverse/static/js/pyverse-runner.js
new file mode 100644
index 0000000..816d62a
--- /dev/null
+++ b/pyverse/static/js/pyverse-runner.js
@@ -0,0 +1,86 @@
+/* Dedicated worker that owns Pyodide for the Practice page.
+ *
+ * Why a worker: Python runs synchronously, so on the page's own thread a
+ * learner's `while True: pass` freezes the tab and nothing can stop it. Here the
+ * page keeps a watchdog and simply terminates this worker (see
+ * pyverse-runtime.js), then starts a fresh one.
+ *
+ * What runs: the SAME Python the templates ship (`includes/pyscript_runtime.html`
+ * — the grader — and `includes/tracer_runtime.html`), handed over as text. That
+ * Python was written for PyScript on the main thread and talks to a handful of
+ * browser objects; the shim below provides exactly those, so nothing is ported
+ * and the grader/tracer stay single-sourced.
+ *
+ * Protocol (main -> worker):  {type:"init", sources:[py…], payload:"<json text>", pyodideUrl?}
+ *                             {type:"exec",  id, code, isSubmit, customJson}
+ *                             {type:"trace", id, code, fn, args, limit}
+ *           (worker -> main): {type:"ready"} | {type:"fatal", error}
+ *                             {type:"result", id, value} | {type:"error", id, error}
+ */
+"use strict";
+
+var PYODIDE_URL = "https://cdn.jsdelivr.net/pyodide/v0.27.7/full/pyodide.js";
+
+var payloadText = "";
+
+// The shipped Python does `from js import document, window` and only these calls:
+//   document.createElement("style") / .head.appendChild / .body.dataset.<flag>
+//   document.getElementById("pyverse-payload").textContent
+//   window._pendingCode, js.window._pyExec = …, js.window._pvTraceCall = …
+self.window = self;
+self.document = {
+  createElement: function () {
+    return {};
+  },
+  head: { appendChild: function () {} },
+  body: { dataset: {} },
+  getElementById: function (id) {
+    return { textContent: id === "pyverse-payload" ? payloadText : "" };
+  },
+};
+
+var pyodide = null;
+
+function toPlain(value) {
+  // Python tuples/lists come back as PyProxy objects; copy to plain JS and free.
+  if (value && typeof value.toJs === "function") {
+    var plain = value.toJs();
+    value.destroy();
+    return plain;
+  }
+  return value;
+}
+
+self.onmessage = async function (event) {
+  var msg = event.data;
+  try {
+    if (msg.type === "init") {
+      payloadText = msg.payload || "";
+      importScripts(msg.pyodideUrl || PYODIDE_URL);
+      pyodide = await self.loadPyodide();
+      for (var i = 0; i < msg.sources.length; i += 1) {
+        await pyodide.runPythonAsync(msg.sources[i]);
+      }
+      self.postMessage({ type: "ready" });
+      return;
+    }
+    if (msg.type === "exec") {
+      self._pendingCode = msg.code || "";
+      var out = toPlain(self._pyExec(!!msg.isSubmit, msg.customJson || "{}"));
+      self.postMessage({ type: "result", id: msg.id, value: [out[0], out[1]] });
+      return;
+    }
+    if (msg.type === "trace") {
+      var raw = self._pvTraceCall(msg.code || "", msg.fn || "", msg.args || "", msg.limit || null);
+      self.postMessage({ type: "result", id: msg.id, value: String(raw) });
+      return;
+    }
+  } catch (error) {
+    var text = String((error && error.message) || error);
+    self.postMessage(
+      msg.type === "init"
+        ? { type: "fatal", error: text }
+        : { type: "error", id: msg.id, error: text }
+    );
+  }
+};
diff --git a/pyverse/static/js/pyverse-runtime.js b/pyverse/static/js/pyverse-runtime.js
new file mode 100644
index 0000000..5d914e5
--- /dev/null
+++ b/pyverse/static/js/pyverse-runtime.js
@@ -0,0 +1,164 @@
+/* Page side of the Practice Python runtime: owns the worker and its watchdog.
+ *
+ *   PyverseRuntime.exec(code, isSubmit, customJson) -> Promise<[metaJson, log]>
+ *   PyverseRuntime.trace(code, fn, args)            -> Promise<traceJson>
+ *   PyverseRuntime.ready()                          -> boolean
+ *
+ * Both calls always resolve (never reject): a run that exceeds its time budget
+ * is killed — the worker is terminated and a new one boots in the background —
+ * and the promise resolves with a normal-looking "time limit exceeded" result,
+ * so the page's existing result handling shows it without special cases.
+ *
+ * Python source is read from the page's `<script type="py">` blocks. PyScript's
+ * loader is NOT on this page, so the browser treats them as inert text.
+ *
+ * Page flags kept for existing pollers: body.dataset.pyverseReady / labReady are
+ * "1" while a worker is ready and "" while it (re)starts. Every change is also
+ * dispatched as `pyverse:runtime` {state: loading | ready | restarting | failed}.
+ */
+(function () {
+  "use strict";
+
+  var script = document.currentScript;
+  var WORKER_URL = script ? script.getAttribute("data-worker") : "";
+  // Optional: where pyodide.js lives (self-hosting). The worker defaults to the CDN.
+  var PYODIDE_URL = (script && script.getAttribute("data-pyodide")) || "";
+  var BUDGET = { run: 5000, submit: 10000, trace: 8000 }; // ms per call, after ready
+
+  var worker = null;
+  var readyPromise = null;
+  var isReady = false;
+  var seq = 0;
+  var pending = null; // the one in-flight call: {id, resolve, reject}
+  var chain = Promise.resolve();
+
+  function sources() {
+    return Array.prototype.map.call(document.querySelectorAll('script[type="py"]'), function (el) {
+      return el.textContent;
+    });
+  }
+
+  function payloadText() {
+    var el = document.getElementById("pyverse-payload");
+    return el ? el.textContent : "";
+  }
+
+  function setState(state, detail) {
+    isReady = state === "ready";
+    document.body.dataset.pyverseReady = isReady ? "1" : "";
+    document.body.dataset.labReady = isReady ? "1" : "";
+    document.dispatchEvent(new CustomEvent("pyverse:runtime", { detail: { state: state, error: detail || null } }));
+  }
+
+  function boot(state) {
+    setState(state);
+    worker = new Worker(WORKER_URL);
+    readyPromise = new Promise(function (resolve) {
+      worker.onmessage = function (event) {
+        var msg = event.data;
+        if (msg.type === "ready") {
+          setState("ready");
+          resolve(true);
+        } else if (msg.type === "fatal") {
+          setState("failed", msg.error);
+          resolve(false);
+        } else if (pending && msg.id === pending.id) {
+          var call = pending;
+          pending = null;
+          if (msg.type === "result") call.resolve(msg.value);
+          else call.reject(new Error(msg.error));
+        }
+      };
+      worker.onerror = function (event) {
+        setState("failed", event.message || "worker error");
+        resolve(false);
+      };
+    });
+    worker.postMessage({ type: "init", sources: sources(), payload: payloadText(), pyodideUrl: PYODIDE_URL });
+  }
+
+  // Run one message through the worker under a wall-clock budget. Resolves with
+  // {ok:true, value} | {ok:false, timeout:true} | {ok:false, error}.
+  function call(message, budget) {
+    var job = chain.then(function () {
+      return readyPromise.then(function (up) {
+        if (!up) return { ok: false, error: "The Python runtime is not available." };
+        return new Promise(function (resolve) {
+          var id = (seq += 1);
+          var timer = window.setTimeout(function () {
+            pending = null;
+            worker.terminate();
+            boot("restarting");
+            resolve({ ok: false, timeout: true });
+          }, budget);
+          pending = {
+            id: id,
+            resolve: function (value) {
+              window.clearTimeout(timer);
+              resolve({ ok: true, value: value });
+            },
+            reject: function (error) {
+              window.clearTimeout(timer);
+              resolve({ ok: false, error: error.message });
+            },
+          };
+          message.id = id;
+          worker.postMessage(message);
+        });
+      });
+    });
+    chain = job;
+    return job;
+  }
+
+  function seconds(ms) {
+    return Math.round(ms / 100) / 10;
+  }
+
+  function exec(code, isSubmit, customJson) {
+    var budget = isSubmit ? BUDGET.submit : BUDGET.run;
+    return call({ type: "exec", code: code, isSubmit: isSubmit, customJson: customJson }, budget).then(function (r) {
+      if (r.ok) return r.value;
+      var total = 0;
+      try {
+        total = (JSON.parse(payloadText()).cases || []).length;
+      } catch (error) {
+        total = 0;
+      }
+      var log = r.timeout
+        ? "Time limit exceeded (" + seconds(budget) + " s).\n\nYour code ran for too long — most often a loop that never ends " +
+          "(check the loop condition and that something inside it changes). The Python runtime was restarted; " +
+          "your editor is untouched."
+        : "RuntimeError: " + r.error;
+      return [JSON.stringify({ status: "RUNTIME_ERROR", latency: 0, passed: 0, total: total }), log];
+    });
+  }
+
+  function trace(code, fn, args) {
+    return call({ type: "trace", code: code, fn: fn, args: args, limit: 200000 }, BUDGET.trace).then(function (r) {
+      if (r.ok) return r.value;
+      return JSON.stringify({
+        steps: [],
+        stdout: "",
+        error: r.timeout
+          ? "Time limit exceeded (" + seconds(BUDGET.trace) + " s) — this call never finished. The Python runtime was restarted."
+          : "RuntimeError: " + r.error,
+        error_line: null,
+        truncated: false,
+        source: code || "",
+        harness_from: null,
+      });
+    });
+  }
+
+  window.PyverseRuntime = {
+    exec: exec,
+    trace: trace,
+    ready: function () {
+      return isReady;
+    },
+  };
+
+  if (WORKER_URL) boot("loading");
+  else setState("failed", "no worker url");
+})();
diff --git a/pyverse/static/js/tutor-view.js b/pyverse/static/js/tutor-view.js
new file mode 100644
index 0000000..e701602
--- /dev/null
+++ b/pyverse/static/js/tutor-view.js
@@ -0,0 +1,405 @@
+/* Step-through view of a trace, laid out like Python Tutor:
+ * code with "just ran" / "runs next" arrows on the left; print output, Frames
+ * (global + every active call) and Objects (lists, dicts, instances, drawn once
+ * and pointed at) on the right.
+ *
+ * It renders the JSON of `includes/tracer_runtime.html` (`steps[].stack`,
+ * `final`, `stdout`, `error`, `harness_from`) and nothing else — no Python, no
+ * network. A host drives it through `window.PyverseLab`:
+ *     show(traceJson)  setStatus(kind, text)  setMode(_)  retrace (host-assigned)
+ * the same surface the Labs engine exposes, so problem-trace.js is unchanged.
+ */
+(function () {
+  "use strict";
+
+  var root = document.getElementById("lab-root");
+  if (!root) return;
+
+  function $(id) {
+    return document.getElementById(id);
+  }
+  var el = {
+    code: $("tv-code"),
+    status: $("tv-status"),
+    note: $("tv-note"),
+    out: $("tv-out"),
+    error: $("tv-error"),
+    frames: $("tv-frames"),
+    objects: $("tv-objects"),
+    inner: $("tv-vizin"),
+    svg: $("tv-arrows"),
+    slider: $("tv-slider"),
+    first: $("tv-first"),
+    prev: $("tv-prev"),
+    next: $("tv-next"),
+    last: $("tv-last"),
+    pill: $("lab-status"),
+  };
+
+  var state = { trace: null, steps: [], i: 0, lines: [] };
+
+  // ── helpers ──────────────────────────────────────────────────────────────
+  function esc(text) {
+    return String(text).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
+  }
+  function make(tag, cls, html) {
+    var node = document.createElement(tag);
+    if (cls) node.className = cls;
+    if (html !== undefined) node.innerHTML = html;
+    return node;
+  }
+
+  // ── syntax highlighting (small, line-safe) ───────────────────────────────
+  var KEYWORDS = /^(and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield|None|True|False)$/;
+  var BUILTINS = /^(print|len|range|enumerate|sum|min|max|sorted|reversed|list|dict|set|tuple|str|int|float|bool|abs|zip|map|filter|any|all|isinstance|type|input|open)$/;
+  var TOKEN = /("""[\s\S]*?"""|'''[\s\S]*?'''|"(?:\\.|[^"\\\n])*"?|'(?:\\.|[^'\\\n])*'?)|(#[^\n]*)|(\b\d+(?:\.\d+)?\b)|(\b[A-Za-z_]\w*\b)|([\s\S])/g;
+
+  function highlight(source) {
+    var lines = [""];
+    var afterDef = false;
+    function push(cls, text) {
+      text.split("\n").forEach(function (part, index) {
+        if (index > 0) lines.push("");
+        if (part === "") return;
+        var safe = esc(part);
+        lines[lines.length - 1] += cls ? '<span class="' + cls + '">' + safe + "</span>" : safe;
+      });
+    }
+    var m;
+    TOKEN.lastIndex = 0;
+    while ((m = TOKEN.exec(source)) !== null) {
+      if (m[1]) push("tv-s", m[1]);
+      else if (m[2]) push("tv-c", m[2]);
+      else if (m[3]) push("tv-n", m[3]);
+      else if (m[4]) {
+        if (afterDef) {
+          push("tv-f", m[4]);
+          afterDef = false;
+        } else if (KEYWORDS.test(m[4])) {
+          push("tv-k", m[4]);
+          afterDef = m[4] === "def" || m[4] === "class";
+        } else if (BUILTINS.test(m[4])) push("tv-b", m[4]);
+        else push("", m[4]);
+      } else {
+        push("", m[5]);
+        if (!/\s/.test(m[5])) afterDef = false;
+      }
+    }
+    return lines;
+  }
+
+  // ── turn a trace into display steps ──────────────────────────────────────
+  // Each display step has: kind, next (line about to run), exec (line that just
+  // ran), stack [{fn,line,vars,ret?}], out (chars of stdout printed so far).
+  function buildSteps(trace) {
+    var out = [];
+    var raw = trace.steps || [];
+    raw.forEach(function (s) {
+      var stack = s.stack && s.stack.length ? s.stack : [{ fn: s.fn, line: s.line, vars: s.vars }];
+      out.push({ kind: "line", next: s.line, stack: stack, out: s.out, depth: s.depth });
+      if (s.returned !== undefined) {
+        // The function is about to hand back its value: show it in the frame,
+        // and point the red arrow at the line the caller resumes on.
+        var withRet = stack.map(function (frame, index) {
+          return index === stack.length - 1 ? Object.assign({}, frame, { ret: s.returned }) : frame;
+        });
+        var caller = stack.length > 1 ? stack[stack.length - 2].line : null;
+        out.push({ kind: "return", next: caller, stack: withRet, out: s.out, depth: s.depth });
+      }
+    });
+    if (!trace.truncated) {
+      if (trace.error) {
+        var last = raw.length ? raw[raw.length - 1] : null;
+        out.push({
+          kind: "error",
+          next: trace.error_line || (last && last.line) || null,
+          stack: last && last.stack ? last.stack : [{ fn: "<module>", line: null, vars: trace.final || {} }],
+          out: (trace.stdout || "").length,
+          error: trace.error,
+        });
+      } else {
+        out.push({
+          kind: "done",
+          next: null,
+          stack: [{ fn: "<module>", line: null, vars: trace.final || {} }],
+          out: (trace.stdout || "").length,
+        });
+      }
+    }
+    out.forEach(function (step, index) {
+      step.exec = index ? out[index - 1].next : null;
+    });
+    return out;
+  }
+
+  // ── values ───────────────────────────────────────────────────────────────
+  function isContainer(node) {
+    return node && (node.k === "seq" || node.k === "dict" || node.k === "obj") && node.oid !== undefined;
+  }
+
+  function primitive(node) {
+    switch (node.k) {
+      case "none":
+        return '<span class="tv-v tv-none">None</span>';
+      case "bool":
+        return '<span class="tv-v tv-bool">' + (node.v ? "True" : "False") + "</span>";
+      case "int":
+      case "float":
+        return '<span class="tv-v tv-num">' + esc(node.v) + "</span>";
+      case "str":
+        return '<span class="tv-v tv-str">"' + esc(node.v) + '"</span>';
+      case "func":
+        return '<span class="tv-v tv-func" title="' + esc(node.v) + '">function ' + esc(node.v) + "</span>";
+      case "cycle":
+        return '<span class="tv-v tv-dim">↺ ' + esc(node.t || "") + " (cycle)</span>";
+      case "deep":
+        return '<span class="tv-v tv-dim">' + esc(node.t || "") + " …</span>";
+      default:
+        return '<span class="tv-v tv-str">' + esc(node.v !== undefined ? node.v : node.t || "?") + "</span>";
+    }
+  }
+
+  // A value cell: primitives inline; containers become a dot that an arrow
+  // leaves from (the object itself is drawn once, in the Objects column).
+  function valueHtml(node, heap) {
+    if (isContainer(node)) {
+      collect(node, heap);
+      return '<span class="tv-ptr" data-target="' + node.oid + '" title="' + esc(node.t || node.k) + '"></span>';
+    }
+    return primitive(node);
+  }
+
+  function collect(node, heap) {
+    if (!isContainer(node) || heap.map[node.oid]) return;
+    heap.map[node.oid] = node;
+    heap.order.push(node.oid);
+    if (node.k === "seq") node.items.forEach(function (item) { collect(item, heap); });
+    else if (node.k === "dict")
+      node.entries.forEach(function (entry) {
+        collect(entry.k, heap);
+        collect(entry.v, heap);
+      });
